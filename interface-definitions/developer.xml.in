<?xml version="1.0"?>
<interfaceDefinition>
  <node name="system">
    <children>
      <node name="developer" owner="${vyos_conf_scripts_dir}/developer_name.py">
        <properties>
          <help>System developer options</help>
          <priority>999</priority>
        </properties>
        <children>
          <leafNode name="name">
            <properties>
              <help>Developer name</help>
              <valueHelp>
                <format>text</format>
                <description>Your name</description>
              </valueHelp>
              <constraint>
                <regex>.*</regex>
              </constraint>
              <constraintErrorMessage>Invalid name</constraintErrorMessage>
            </properties>
           </leafNode>
        </children>
      </node>
    </children>
  </node>
</interfaceDefinition>
