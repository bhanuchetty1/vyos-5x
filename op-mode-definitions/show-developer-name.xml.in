<?xml version="1.0"?>
<interfaceDefinition>
  <node name="show">
    <children>
      <node name="developer">
        <properties>
          <help>Show developer information</help>
        </properties>
        <children>
          <leafNode name="name">
            <properties>
              <help>Show developer name</help>
            </properties>
            <command>${vyos_op_scripts_dir}/show_developer_name.py</command>
          </leafNode>
        </children>
      </node>
    </children>
  </node>
</interfaceDefinition>
